# Copy this file to .dev.env or .prod.env and replace every CHANGE_ME value.
# Select production with SPRING_PROFILES_ACTIVE=prod; dev is the default profile.
# Never expose this file through frontend/Vite configuration.

# HTTP server
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/kiroProxy
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT=3000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT=3s
REDIS_TIMEOUT=2s

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME

# Admin authentication and browser origins
# Generate with: openssl rand -hex 32
KIRO_ADMIN_JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_BYTES
KIRO_ADMIN_JWT_EXPIRATION=12h
KIRO_ADMIN_ALLOWED_ORIGIN_PATTERNS=https://admin.example.com

# Billing
KIRO_BILLING_MESSAGING_ENABLED=true
KIRO_BILLING_DEFAULT_INITIAL_POINTS=100
KIRO_BILLING_REQUEST_RESERVE_POINTS=1
KIRO_BILLING_LOW_BALANCE_THRESHOLD=0.5
KIRO_BILLING_SETTLEMENT_EXCHANGE=billing.settlement.exchange
KIRO_BILLING_SETTLEMENT_QUEUE=billing.settlement.queue
KIRO_BILLING_SETTLEMENT_ROUTING_KEY=billing.settlement
KIRO_BILLING_OUTBOX_DELAY_MS=1000

# Relay
RELAY_CONNECT_TIMEOUT=15s
RELAY_REQUEST_TIMEOUT=10m
RELAY_AFFINITY_IDLE_TTL=60m
RELAY_AFFINITY_MAXIMUM_TTL=12h
RELAY_AFFINITY_QUEUE_WAIT=10s
RELAY_HEALTH_INTERVAL_MS=30000
RELAY_HEALTH_INITIAL_DELAY_MS=30000
RELAY_HEALTH_TIMEOUT=8s
RELAY_HEALTH_PARALLELISM=4
RELAY_STREAM_CORE_POOL_SIZE=16
RELAY_STREAM_MAX_POOL_SIZE=200
RELAY_STREAM_QUEUE_CAPACITY=0
RELAY_STREAM_ASYNC_TIMEOUT=11m

# Documentation media cleanup
KIRO_DOCS_MEDIA_CLEANUP_DELAY_MS=60000
# Flyway: run `repair` before `migrate` on startup. Keep this false.
# Only set it to true for a single boot when an already-migrated database reports
# "Migration checksum mismatch" because a historical migration script was edited
# (this repository rewrote V2__seed_required_data.sql to remove secrets).
# `repair` only realigns checksums in flyway_schema_history; it replays no DDL/DML.
# Remove it again afterwards so migration validation keeps protecting you.
# 仅在数据库已跑过旧版迁移、启动报 "Migration checksum mismatch" 时临时设为 true 启动一次；
# repair 只对齐 flyway_schema_history 的校验和，不重放任何 DDL/DML，修复后请撤掉。
KIRO_FLYWAY_REPAIR_BEFORE_MIGRATE=false

# OpenAPI/Swagger endpoints. The prod profile disables both by default, so
# /swagger-ui.html and /v3/api-docs return 404 while every REST endpoint keeps working.
# Set to true only for temporary troubleshooting.
SPRINGDOC_SWAGGER_UI_ENABLED=false
SPRINGDOC_API_DOCS_ENABLED=false

# Cloudflare R2
R2_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=CHANGE_ME
R2_PUBLIC_BASE_URL=https://files.example.com
R2_REGION=auto
