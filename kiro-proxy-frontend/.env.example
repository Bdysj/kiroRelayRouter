# 复制为 .env.local（本地开发）或 .env.production（生产构建）后填入真实地址。
# Copy to .env.local (local dev) or .env.production (production build), then fill in real values.
# 这两个文件都已被 .gitignore 排除，请勿把线上域名提交到仓库。
# Both files are git-ignored: never commit a production hostname.

# kiroProxy 管理端 API 基础地址（必须以 /api 结尾）。
# Base URL of the kiroProxy admin API (must end with /api).
VITE_KIRO_API_BASE_URL=http://127.0.0.1:8080/api

# 兼容用的备用基础地址。VITE_KIRO_API_BASE_URL 缺省时才会读取。
# Legacy fallback base URL, only read when VITE_KIRO_API_BASE_URL is unset.
VITE_API_BASE_URL=http://127.0.0.1:8080/api
